<dictionary>
  <alphabet/>
  <sdefs>
    <sdef n="n"       c="Noun"/>
    <sdef n="np"      c="Proper noun"/>
    <sdef n="prn"     c="Pronoun"/>
    <sdef n="det"     c="Determiner"/>
    <sdef n="pos"     c="Possessive"/>
    <sdef n="predet"  c=""/>

    <sdef n="p1"      c="1st person"/>
    <sdef n="p2"      c="2nd person"/>
    <sdef n="p3"      c="3rd person"/>

    <sdef n="nt"      c="Neuter"/>
    <sdef n="mf"      c="Masculine / feminine, also utrum in nouns"/>
    <sdef n="fn"      c="Feminine / neutrum"/>
    <sdef n="f"       c="Feminine"/>
    <sdef n="m"       c="Masculine"/>
    <sdef n="ut"      c="Utrum"/>
    <sdef n="un"      c="Utrum / neutrum"/>

    <sdef n="sp"      c="Singular / plural"/>
    <sdef n="sg"      c="Singular"/>
    <sdef n="pl"      c="Plural"/>

    <sdef n="ind"     c="Indefinite"/>
    <sdef n="def"     c="Definite"/>

    <sdef n="cmp"     c="Compound part"/>
    <sdef n="cmp-split" c="Left part of a split compound"/>

    <sdef n="nom"     c="Nominative"/>
    <sdef n="acc"     c="Accusative"/>        <!-- objective case -->
    <sdef n="gen"     c="Genitive"/>

    <sdef n="dem"     c="Demonstrative"/>
    <sdef n="itg"     c="Question word / interrogative"/>
    <sdef n="rel"     c="Relativiser"/>
    <sdef n="qnt"     c="Quantifier"/>
    <sdef n="res"     c=""/>
    <sdef n="pers"    c="Personal"/>
    <sdef n="neg"     c="Negative"/>
    <sdef n="ref"     c="Reflexive"/>
    <sdef n="emph"   c="Emphatic"/>

    <sdef n="vblex"   c="Verb"/>
    <sdef n="vaux"   c="Verb"/>
    <sdef n="vbser"   c="Verb"/>
    <sdef n="vbhaver"   c="Verb"/>
    <sdef n="vbmod"   c="Verb"/>

    <sdef n="pstv"    c="-st verb (Nynorsk)"/>
    <sdef n="pasv"    c="Passive (Swedish, Bokmål) or -st form (Nynorsk)"/>
    <sdef n="actv"    c="Active (Swedish)"/>
    <sdef n="inf"     c="Infinitive"/>
    <sdef n="pres"    c="Present"/>
    <sdef n="pis"       c="Past/imperfect subjunctive"/>
    <sdef n="prs"       c="Present subjunctive"/>
    <sdef n="imp"     c="Imperative"/>
    <sdef n="past"     c="Past tense (Danish)"/>
    <sdef n="pret"     c="Past tense (Bokmål)"/>

    <sdef n="pp"      c="Perfect participle"/>
    <sdef n="pprs"    c="Present participle (adjectival)"/>
    <sdef n="supn"    c="Supine"/>

    <sdef n="pr"      c="Preposition"/>
    <sdef n="ij"      c="Interjection"/>
    <sdef n="adv"     c="Adverb"/>
    <sdef n="adj"     c="Adjective"/>
    <sdef n="sint"    c="Synthetic (of adjectives)"/>
    <sdef n="part"    c="Infinitive mark (nno/nob)"/>
    <sdef n="cnjsub"  c="Subordinating conjunction"/>
    <sdef n="cnjcoo"  c="Co-ordinating conjunction"/>
    <sdef n="cnjadv"  c="Adverbial conjunction"/>


    <sdef n="pst"       c="Positive degree"/>
    <sdef n="comp"    c="Comparative"/>
    <sdef n="sup"     c="Superlative"/>
    <sdef n="xpst"    c="Positive derivative"/>
    <sdef n="xpsts"   c="Positive derivative of synthetics"/>
    <sdef n="xpsto"   c="Positive derivative of ordinals"/>
    <sdef n="xcomp"   c="Comparative derivative"/>
    <sdef n="xsup"    c="Superlative derivative"/>

    <sdef n="ord"     c="Ordinal"/>
    <sdef n="acr"     c="Acronym"/>
    <sdef n="sent"    c="Sentence end" />
    <sdef n="rquot"   c="" />
    <sdef n="lquot"   c="" />
    <sdef n="cm"      c="Comma" />
    <sdef n="clb"     c="Possible clause boundary"/>
    <sdef n="apos"    c="Apostrophe" />
    <sdef n="guio"    c="Dash" />
    <sdef n="lpar"    c="Left parenthesis" />
    <sdef n="rpar"    c="Right parenthesis" />

    <sdef n="top"     c="Toponym" />
    <sdef n="ant"     c="Anthroponym" />
    <sdef n="cog"   c="Cognomen"/>
    <sdef n="org"  c="Organisation"/>
    <sdef n="al"  c="Altres / misc proper nouns"/>

    <sdef n="cgguess" 	c="CG Guesser"/>
    <sdef n="url" 	c="URL/E-mail"/>

    <sdef n="AD"     c="Auxiliary to be done"/>
    <sdef n="GD"     c="Género por determinar" />
    <sdef n="ND"     c="Número por determinar" />
    <sdef n="VD"     c="Voice por determinar – only used where both pasv and actv can be generated" />
  </sdefs>

  <pardefs>

    <pardef n="n_cmp_only">
<e><p><l><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></r></p></e>
<e><p><l><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp-split"/></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp-split"/></r></p></e>
    </pardef>
    <pardef n="n_sp_cmp_only">
<e><p><l><s n="n"/><s n="nt"/><s n="sp"/><s n="cmp"/></l><r><s n="n"/><s n="nt"/><s n="sp"/><s n="cmp"/></r></p></e>
<e><p><l><s n="n"/><s n="nt"/><s n="sp"/><s n="cmp-split"/></l><r><s n="n"/><s n="nt"/><s n="sp"/><s n="cmp-split"/></r></p></e>
    </pardef>

<!-- generate f for nno, m for nob; analyse both for both langs: -->
<pardef n=":f/m">
<e vr="nob">        <p><l></l><r><s n="m"/></r></p></e>
<e vr="nno">        <p><l></l><r><s n="f"/></r></p></e>
</pardef>

<pardef n="sgpl:sp" c="TODO: ND/DD">
<e>       <p><l><s n="sg"/><s n="ind"/></l><r><s n="sp"/></r></p></e>
<e r="LR"><p><l><s n="pl"/><s n="ind"/></l><r><s n="sp"/></r></p></e>
<e r="LR"><p><l><s n="sg"/><s n="def"/></l><r><s n="sp"/></r></p></e>
<e r="LR"><p><l><s n="pl"/><s n="def"/></l><r><s n="sp"/></r></p></e>
</pardef>

<pardef n="pl:sg" c="mjukvaror = programvare">
<e>         <p><l><s n="sg"/><s n="ind"/><s n="cmp"/></l> <r><s n="sg"/><s n="ind"/><s n="cmp"/></r></p></e>
<e>         <p><l><s n="pl"/><s n="ind"/></l>             <r><s n="sg"/><s n="ind"/></r></p></e>
<e>         <p><l><s n="pl"/></l>                         <r><s n="sg"/></r></p></e>
<e>         <p><l></l>                                    <r></r></p></e>
</pardef>


<pardef n="gen:" c="just strip the swe gender">
<e r="LR">  <p><l><s n="nt"/></l><r></r></p></e>
<e r="LR">  <p><l><s n="ut"/></l><r></r></p></e>
<e>         <p><l><s n="un"/></l><r></r></p></e>
</pardef>

<pardef n="cas:" c="just strip the swe case">
<e r="LR">  <p><l><s n="gen"/></l><r></r></p></e>
<e>         <p><l></l><r></r></p></e>
<e>       <p><l>NON_ANALYSIS</l>          <r>DUE_TO_LT_PROC_HANG</r></p></e>
</pardef>

<pardef n="nom_cas:nom" c="nom/gen→nom (transfer handles swe genitive)">
<e r="LR">  <p><l><s n="gen"/></l><r><s n="nom"/></r></p></e>
<e>         <p><l><s n="nom"/></l><r><s n="nom"/></r></p></e>
<e>       <p><l>NON_ANALYSIS</l>          <r>DUE_TO_LT_PROC_HANG</r></p></e>
</pardef>
<pardef n="nom_cas:" c="nom on swe-side; ignore genitives …">
<e r="LR">  <p><l><s n="gen"/></l><r></r></p></e>
<e>         <p><l><s n="nom"/></l><r></r></p></e>
<e>       <p><l>NON_ANALYSIS</l>          <r>DUE_TO_LT_PROC_HANG</r></p></e>
</pardef>



    <!-- Use trimming to restrict some entries, typically since
         monodix only contains partial pardefs:
    -->
    <pardef n="@sg" c="only allow sg">
<e>       <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
    </pardef>
    <pardef n="@pl" c="only allow pl">
<e>       <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="@un_pl" c="only allow un.pl">
<e>       <p><l><s n="un"/><s n="pl"/></l><r><s n="un"/><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="@sgpl" c="only allow sg/pl (disallow sp)">
<e>       <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
<e>       <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="@ind" c="only allow ind">
<e>       <p><l><s n="sg"/><s n="ind"/></l><r><s n="sg"/><s n="ind"/></r></p></e>
<e>       <p><l><s n="pl"/><s n="ind"/></l><r><s n="pl"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="@def" c="only allow def">
<e>       <p><l><s n="sg"/><s n="def"/></l><r><s n="sg"/><s n="def"/></r></p></e>
<e>       <p><l><s n="pl"/><s n="def"/></l><r><s n="pl"/><s n="def"/></r></p></e>
    </pardef>
    <pardef n="@sg_ind" c="only allow sg ind">
<e>       <p><l><s n="sg"/><s n="ind"/></l><r><s n="sg"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="@sg_def" c="only allow sg def">
<e>       <p><l><s n="sg"/><s n="def"/></l><r><s n="sg"/><s n="def"/></r></p></e>
    </pardef>
    <pardef n="@pl_ind" c="only allow pl ind">
<e>       <p><l><s n="pl"/><s n="ind"/></l><r><s n="pl"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="@pl_def" c="only allow pl def">
<e>       <p><l><s n="pl"/><s n="def"/></l><r><s n="pl"/><s n="def"/></r></p></e>
    </pardef>

    <pardef n="sg_ind:" c="sg ind on the swe-side
                           (some swe np.ant's have more possible forms; currently ignored)">
<e>       <p><l><s n="sg"/><s n="ind"/></l><r></r></p></e>
    </pardef>


<!-- determinatives -->
<pardef n="__det" c="TODO: GD?">
<e r="RL"><p><l><s n="ut"/><s n="sg"/></l>           <r><s n="f"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="ut"/><s n="sg"/></l>           <r><s n="m"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="nt"/><s n="sg"/></l>           <r><s n="nt"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="pl"/></l>                      <r><s n="pl"/></r></p></e>
<e>       <p><l><s n="un"/></l>                      <r><s n="un"/></r></p></e>
</pardef>
<pardef n="un:__det" c="TODO: GD?">
<e r="RL"><p><l><s n="ut"/><s n="sg"/></l>             <r><s n="f"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="ut"/><s n="sg"/></l>             <r><s n="m"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="nt"/><s n="sg"/></l>             <r><s n="nt"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="un"/><s n="pl"/></l>             <r><s n="pl"/></r></p></e>
</pardef>
<pardef n="un_sp:__det" c="TODO: GD?">
<e r="RL"><p><l><s n="un"/><s n="sp"/></l>             <r><s n="f"/><s n="sg"/></r></p></e>
<e r="RL"><p><l><s n="un"/><s n="sp"/></l>             <r><s n="m"/><s n="sg"/></r></p></e>
<e r="RL"><p><l><s n="un"/><s n="sp"/></l>             <r><s n="nt"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="un"/><s n="sp"/></l>             <r><s n="pl"/></r></p></e>
</pardef>
<pardef n="sp:sg__det" c="TODO: GD?">
<e r="RL"><p><l><s n="un"/><s n="sp"/></l>             <r><s n="f"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="un"/><s n="sp"/></l>             <r><s n="m"/><s n="sg"/></r></p></e>
<e>       <p><l><s n="nt"/><s n="sg"/></l>             <r><s n="nt"/><s n="sg"/></r></p></e>
</pardef>
<pardef n="sp:sp_def__det" c="TODO: GD?">
<e r="RL"><p><l><s n="ut"/><s n="sp"/></l>             <r><s n="f"/><s n="sp"/><s n="def"/></r></p></e>
<e>       <p><l><s n="ut"/><s n="sp"/></l>             <r><s n="m"/><s n="sp"/><s n="def"/></r></p></e>
<e>       <p><l><s n="nt"/><s n="sg"/></l>             <r><s n="nt"/><s n="sp"/><s n="def"/></r></p></e>
</pardef>
<pardef n="un:pl__det">
<e r="LR"><p><l><s n="ut"/><s n="sg"/></l>             <r><s n="pl"/></r></p></e>
<e r="LR"><p><l><s n="nt"/><s n="sg"/></l>             <r><s n="pl"/></r></p></e>
<e>       <p><l><s n="un"/><s n="pl"/></l>             <r><s n="pl"/></r></p></e>
</pardef>
<pardef n="un:defnes__det" c="TODO: GD?">
<e r="RL"><p><l><s n="ut"/><s n="sg"/></l>             <r><s n="f"/><s n="sg"/><s n="ind"/></r></p></e>
<e>       <p><l><s n="ut"/><s n="sg"/></l>             <r><s n="m"/><s n="sg"/><s n="ind"/></r></p></e>
<e>       <p><l><s n="nt"/><s n="sg"/></l>             <r><s n="nt"/><s n="sg"/><s n="ind"/></r></p></e>
<e>       <p><l><s n="un"/><s n="pl"/></l>             <r><s n="pl"/></r></p></e>
<e r="RL"><p><l><s n="un"/><s n="pl"/></l>             <r><s n="sg"/><s n="def"/></r></p></e>
</pardef>
<pardef n="nom__prn:def__det" c="samma:samme">
<e>         <p><l><s n="nt"/><s n="sg"/><s n="nom"/></l>             <r><s n="nt"/><s n="sp"/><s n="def"/></r></p></e>
<e>         <p><l><s n="ut"/><s n="sg"/><s n="nom"/></l>             <r><s n="m"/><s n="sp"/><s n="def"/></r></p></e>
<e>         <p><l><s n="ut"/><s n="sg"/><s n="nom"/></l>             <r><s n="f"/><s n="sp"/><s n="def"/></r></p></e>
<e r="LR">  <p><l><s n="un"/><s n="pl"/><s n="nom"/></l>             <r><s n="nt"/><s n="sp"/><s n="def"/></r></p></e>
</pardef>
<pardef n="nom__prn:qnt__det" c="all:all">
<e>         <p><l><s n="nt"/><s n="sg"/><s n="nom"/></l>             <r><s n="nt"/><s n="sg"/></r></p></e>
<e>         <p><l><s n="ut"/><s n="sg"/><s n="nom"/></l>             <r><s n="m"/><s n="sg"/></r></p></e>
<e>         <p><l><s n="ut"/><s n="sg"/><s n="nom"/></l>             <r><s n="f"/><s n="sg"/></r></p></e>
<e>         <p><l><s n="un"/><s n="pl"/><s n="nom"/></l>             <r><s n="un"/><s n="pl"/></r></p></e>
</pardef>

<!-- Verbs -->
    <pardef n="vblex">
<e>       <p><l><s n="vblex"/><s n="past"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l>    <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="past"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pret"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="pis"/><s n="actv"/></l>    <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pres"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="prs"/><s n="actv"/></l>    <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="actv"/></l>    <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="imp"/></l>                 <r><s n="vblex"/><s n="imp"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="supn"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pp"/></r></p></e>
<e r="RL"><p><l><s n="vblex"/><s n="supn"/><s n="VD"/></l>     <r><s n="vblex"/><s n="pp"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="supn"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                                 <r><s n="adj"/><s n="pprs"/></r></p><par n="cas:"/></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="pl"/><s n="ind"/></l>            <r><s n="adj"/><s n="pp"/><s n="pl"/></r></p><par n="cas:"/></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="fn"/><s n="sg"/><s n="def"/></l> <r><s n="adj"/><s n="pp"/><s n="sg"/><s n="def"/></r></p><par n="cas:"/></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="ut"/><s n="sg"/><s n="ind"/></l> <r><s n="adj"/><s n="pp"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p><par n="cas:"/></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="nt"/><s n="sg"/><s n="ind"/></l> <r><s n="adj"/><s n="pp"/><s n="nt"/><s n="sg"/><s n="ind"/></r></p><par n="cas:"/></e>
    </pardef>
    <pardef n="vblex_no-adjpp">
<e>       <p><l><s n="vblex"/><s n="past"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l>    <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="past"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pret"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="pis"/><s n="actv"/></l>    <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pres"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="prs"/><s n="actv"/></l>    <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="actv"/></l>    <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="imp"/></l>                 <r><s n="vblex"/><s n="imp"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="supn"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pp"/></r></p></e>
<e r="RL"><p><l><s n="vblex"/><s n="supn"/><s n="VD"/></l>     <r><s n="vblex"/><s n="pp"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="supn"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                                 <r><s n="adj"/><s n="pprs"/></r></p><par n="cas:"/></e>
    </pardef>
    <pardef n="vblex_no-adjpp-pastpasv">
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
