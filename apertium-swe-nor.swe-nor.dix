<e><re>[0-9]+</re><p><l>-år<s n="n"/><s n="nt"/></l><r>-år<s n="n"/><s n="nt"/></r></p></e>
<e><i>topp-</i><re>[0-9]+</re><p><l><s n="n"/><s n="ut"/></l><r><s n="n"/><s n="m"/></r></p></e>
<e><re>[0-9]+[.][0-9]+</re><p><l>-tid<s n="n"/><s n="ut"/></l><r>-tid<s n="n"/></r></p><par n=":f/m"/></e>
<e><re>[0-9]+</re><p><l>:e<b/>plats<s n="n"/><s n="ut"/></l><r>.-plass<s n="n"/><s n="m"/></r></p></e>
<e><re>[0-9]+</re><p><l>:e<b/>klassing<s n="n"/><s n="ut"/></l><r>.-klassing<s n="n"/><s n="m"/></r></p></e>
<e><re>[0-9]+</re><p><l>:e<b/>omgång<s n="n"/><s n="ut"/></l><r>.-omgang<s n="n"/><s n="m"/></r></p></e>
<e><re>[0-9]+</re><p><l>:e<b/>division<s n="n"/><s n="ut"/></l><r>.-divisjon<s n="n"/><s n="m"/></r></p></e>
<e><re>[0-9]+</re><p><l>:e<b/>division<s n="n"/><s n="ut"/></l><r>.-divisjonsavdeling<s n="n"/></r></p><par n=":f/m"/></e>
<e><re>[0-9]+</re><p><l>:e<b/>lag<s n="n"/><s n="nt"/></l><r>.-lag<s n="n"/><s n="nt"/></r></p></e>

<!-- G20, V75 etc. --> <e><re>[A-ZÆØÅ]+\-?[0-9][0-9A-ZÆØÅ]*</re><p><l><s n="n"/><s n="m"/></l><r><s n="n"/><s n="m"/></r></p></e>

<e>       <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><p><l>baserad</l><r>basert</r></p><par n="adj"/></e>
<e>       <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><p><l>olycka<s n="n"/><s n="ut"/></l><r>ulykke<s n="n"/></r></p><par n=":f/m"/></e>

<e>          <p><l>år<b/>lång</l>   <r>år<b/>lang</r></p><par n="adj"/></e>
<e vr="nno"> <p><l>år<b/>gammal</l> <r>år<b/>gammal</r></p><par n="adj_sint"/></e>
<e vr="nob"> <p><l>år<b/>gammal</l> <r>år<b/>gammel</r></p><par n="adj_sint"/></e>

<e>       <par n="ein-hundre"/><i>–</i><par n="ein-hundre"/><i><s n="det"/><s n="qnt"/></i></e>

<e lm="np cgguess regex"><re>[A-ZÆØÅ][a-zæøå]*</re><i><s n="np"/><s n="cgguess"/></i></e>

<!-- Swedish uses space as thousands-separator, Norwegian typically dot: -->
<e><re>[0-9]+([,][0-9]+)*( ?%)?</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>
<e><re>[0-9]+</re><p><l><b/></l><r>.</r></p><re>[0-9]+</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>
<e r="RL">  <re>[0-9]+ [0-9]+</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>

<e c="2-3-seier"> <re>[0-9]([.0-9–\-]*[0-9])?</re><par n="n_cmp_only"/></e>
<e c="0-9+."> <re>[0-9]+[.]</re><par n="n_cmp_only"/></e>

<e lm="foo.com"> <re>(https?://)?(www.)?([a-zæøå0-9\-_]+[.])+(com|no|net|co[.]uk|fr|se|biz|dk|gov|org|nz|uk|eu)+(/[a-zæøå0-9\-_/]*)?</re><p><l><s n="url"/></l><r><s n="url"/></r></p></e>

<e lm="np-guio regex"><re>[A-ZÆØÅ][a-zæøå]+\-</re><p><l><s n="np"/><s n="cgguess"/><s n="cmp"/></l><r><s n="np"/><s n="cgguess"/><s n="cmp"/></r></p></e>
<e lm="np-guio regex"><re>[A-ZÆØÅ][A-ZÆØÅ]+\-</re><p><l><s n="np"/><s n="cgguess"/><s n="cmp"/></l><r><s n="np"/><s n="cgguess"/><s n="cmp"/></r></p></e>

<e><re>[a-zæøåášŧŋđžčäö]</re><p><l>alphabet<s n="n"/><s n="ut"/></l><r>alphabet<s n="n"/><s n="m"/></r></p></e>

</section>


